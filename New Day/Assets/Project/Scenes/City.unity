  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CityPerson
  displayName: Big Sal
  nameColor: {r: 0.8, g: 0.25, b: 0.2, a: 1}
  personId: vendor_big_sal
  firstMeeting:
  - Hot dogs! Get your hot dogs! ...Hey, a new face. Big Sal. Best dogs in the city, thirty years on this corner.
  - You look like you've walked a long way. Eat something. You'll work twice as hard after.
  lines:
  - One with everything? It fills you right back up.
  - 'The tower tried to buy my corner. I said: you can''t afford it. They could. I still said no.'
  - Farmer, eh? If you ever grow a decent onion, we should talk.
  - Lunch rush is at twelve thirty. Come before it or bring a book.
  oneLineOnly: 0
  service: {fileID: 580837250}
  serviceLabel: I'll take a hot dog
  portraitIdle: {fileID: -694310816, guid: fac235f7671258042b055c462f16ca70, type: 3}
  portraitTalk: {fileID: -1287499570, guid: fac235f7671258042b055c462f16ca70, type: 3}
