  m_GameObject: {fileID: 421543084}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 602e508ab3a03db42a7d1a884c3f6b31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CityPerson
  displayName: Mr. Okafor
  nameColor: {r: 0.35, g: 0.5, b: 0.35, a: 1}
  personId: clerk_mr._okafor
  firstMeeting:
  - Next! Oh. You're not in the queue. There is no queue. Forgive me, it has been that sort of decade.
  - Desmond Okafor, city clerk. Permits, plans and complaints. Mostly complaints.
  - If you want something BUILT in this city, you pay for it here. If you want something DONE, check the notice board.
  lines:
  - Form 12-B is for trees. Form 12-C is for complaints about trees. They are the same form.
  - 'The tower pays its fines on time, every month. That is the problem: to them a fine is just a price.'
  - A boom across the river would catch most of it. The council voted for one. Then the money... went somewhere.
  - Miss Reyes from the suburbs works mornings here. The filing has never been so fast, or so loud.
  oneLineOnly: 0
  service: {fileID: 1699421976}
  serviceLabel: City services
  portraitIdle: {fileID: 1534407596, guid: 09832f0778f5ca446800ff6e5567a4d5, type: 3}
  portraitTalk: {fileID: -718054850, guid: 09832f0778f5ca446800ff6e5567a4d5, type: 3}
