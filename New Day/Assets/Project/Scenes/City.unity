  m_Script: {fileID: 11500000, guid: 5a1f70a1aa4028c4995bc823e0986c81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CityHallDesk
  title: City Hall
  prompt: City services
  improvements:
  - id: trees
    title: Street trees
    description: Young trees in planters along Main Avenue.
    goldCost: 400
    requires: 
    cleansRiver: 0
  - id: flowers
    title: Flower beds
    description: Flower beds on the pavements. The bees will find them.
    goldCost: 300
    requires: 
    cleansRiver: 0
  - id: lamps
    title: Solar street lamps
    description: Lamps that charge in the day and light the river walk at night.
    goldCost: 600
    requires: 
    cleansRiver: 0
  - id: bins
    title: Recycling bins
    description: Bins on every corner, so less ends up on the street.
    goldCost: 350
    requires: 
    cleansRiver: 0
  - id: fountain
    title: Park fountain
    description: A fountain for the little park south of Civic Street.
    goldCost: 1200
    requires: 
    cleansRiver: 0
  - id: bus
    title: Bus stop
    description: A proper shelter on Main Avenue for the bus from the suburbs.
    goldCost: 900
    requires: 
    cleansRiver: 0
  - id: river_boom
    title: River boom
    description: A floating barrier across the river that catches what comes out of the pipe. Cleans the river a great deal.
    goldCost: 1500
    requires: 
    cleansRiver: 1
  - id: river_reeds
    title: Reed beds
    description: Reeds planted along the bank filter the water as it flows west. Cleans the river even more.
    goldCost: 2500
    requires: river_boom
    cleansRiver: 1
  jobs:
  - id: litter
    title: Litter pick
    description: Pick up 10 pieces of litter from the city streets.
    item: {fileID: 0}
    count: 10
    counterKey: litter_collected
    countFromAccept: 1
    rewardGold: 150
    rewardFlag: 
  - id: treat
    title: Do it properly
    description: Take 15 pieces of waste to the treatment plant instead of the river.
    item: {fileID: 0}
    count: 15
    counterKey: trash_treated
    countFromAccept: 1
    rewardGold: 300
    rewardFlag: 
  - id: market
    title: Feed the city
    description: The market is short of fresh food. Sell 30 crops (through your mailbox at home).
    item: {fileID: 0}
    count: 30
    counterKey: crops_sold
    countFromAccept: 1
    rewardGold: 250
    rewardFlag: 
  - id: science
    title: Science fair
    description: The university wants results to show off. Fund 3 research projects.
    item: {fileID: 0}
    count: 3
    counterKey: research_done
    countFromAccept: 1
    rewardGold: 400
    rewardFlag: 
  - id: bridge
    title: Steel for the footbridge
    description: The river footbridge needs iron. Bring 5 Iron Bars (the tower's smelter makes them).
    item: {fileID: 11400000, guid: 8d5988092f2fe8e4abf9b0eb8a00214e, type: 2}
    count: 5
    counterKey: 
    countFromAccept: 1
    rewardGold: 600
    rewardFlag: 
