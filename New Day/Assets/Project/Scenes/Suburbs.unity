    pages:
    - Frank sells a fine hammer and talks a load of nonsense. I go for the hammers.
  - label: Any time
    priority: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
