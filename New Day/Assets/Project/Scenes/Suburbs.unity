  portraitIdle: {fileID: 364461203, guid: 6cdaf16d0c245ca4ab0e53be42fcfdb3, type: 3}
  portraitTalk: {fileID: 1691571422, guid: 6cdaf16d0c245ca4ab0e53be42fcfdb3, type: 3}
