  nameColor: {r: 0.6, g: 0.45, b: 0.25, a: 1}
  firstMeeting:
  - Oh. Um. Hello. Sam Whitaker. I write books. Well. A book. Most of one.
  - Sorry, I'm not good at this part. The talking part.
  chatLines:
  - label: Any time
