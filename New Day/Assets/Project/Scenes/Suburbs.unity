      days: 64
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
      requireFlags: []
      anyFlags: []
      forbidFlags: []
      counters: []
    pages:
    - No mail on Sundays. Sundays are for football with the family.
