  portraitIdle: {fileID: 1125398735, guid: 78c1e0197a5cdbf4d88aae9b6fc3d871, type: 3}
  portraitTalk: {fileID: 737256883, guid: 78c1e0197a5cdbf4d88aae9b6fc3d871, type: 3}
  portraitHappy: {fileID: -13269053, guid: 78c1e0197a5cdbf4d88aae9b6fc3d871, type: 3}
