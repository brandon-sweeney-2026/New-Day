  nameColor: {r: 0.4, g: 0.45, b: 0.3, a: 1}
  firstMeeting:
  - Hm. You're the one who took the old farm. Walt Delgado.
  - I built half the porches on this street, and the other half I had opinions about.
  chatLines:
  - label: Any time
    priority: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
