  nameColor: {r: 0.3, g: 0.55, b: 0.3, a: 1}
  firstMeeting:
  - 'Hello there. Mateo Reyes. I look after the park: the trees, the pitch, the sandbox, all of it.'
  - A farmer! Good. Somebody else who knows you can't hurry a plant.
  chatLines:
  - label: Any time
