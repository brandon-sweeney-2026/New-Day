  nameColor: {r: 0.4, g: 0.55, b: 0.35, a: 1}
  firstMeeting:
  - Oh! Hello! Bea Lindqvist. I study botany at the university. You're a farmer, so you're basically my hero.
  - Could I ask about your soil some time? I have... a list. A short list. Forty questions.
  chatLines:
  - label: Any time
    priority: 0
    conditions:
      days: 0
