      counters: []
    pages:
    - Dev and I are getting a five-a-side going in the park. You any good in goal?
  - label: Default 3
    priority: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
