  nameColor: {r: 0.25, g: 0.35, b: 0.55, a: 1}
  firstMeeting:
  - Welcome, welcome! I'm Jae-hoon. My wife and I run this shop.
  - Seeds, snacks, slush - if we don't have it, tell me and I'll order it.
  chatLines:
  - label: Default
    priority: 0
    conditions:
      days: 0
      seasons: 0
