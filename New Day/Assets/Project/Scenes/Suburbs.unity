    pages:
    - I'm drawing every house on the street. Sam's has the best front door and the saddest curtains.
  - label: Any time
    priority: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
