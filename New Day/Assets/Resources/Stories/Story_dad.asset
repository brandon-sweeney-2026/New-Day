      optionB: 
      replyB: []
      flagsB: []
    setFlags: []
    reward:
      gold: 0
      item: {fileID: 0}
      amount: 0
      friendship: 0
  - title: The bright cold shop
    number: 9
    heartsNeeded: 9
    path: 2
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
      requireFlags: []
      anyFlags: []
      forbidFlags: []
      counters: []
    pages:
    - New lights. Very bright. New fridges. Very cold. The till talks to the tower all by itself.
    - The regulars still come. But they don't stay at the counter any more. There's nothing to talk about. The prices are the same as everywhere.
    - Rosa bought bread yesterday. Not hers. Theirs. She didn't say anything and neither did I.
    happy: 0
    ask:
      item: {fileID: 0}
      amount: 0
      minQuality: 0
      questTitle: 
      questText: 
      reminder: []
      thanks: []
    choice:
      enabled: 0
