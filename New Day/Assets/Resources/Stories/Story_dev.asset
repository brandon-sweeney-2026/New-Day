  m_Name: Story_dev
  m_EditorClassIdentifier: Assembly-CSharp::NpcStoryArc
  npcId: dev
  title: The Best Left Foot
  summary: 'Dev is sixteen, cooks pasta on Thursdays, and has the best left foot Lucia has coached. A Sterling-sponsored academy wants him, but he''d have to leave his mum alone. Fork: stay and play the Suburb Cup, or take the academy place.'
  pathAName: Stay with the team
  pathBName: Join the academy
  parts:
  - title: We need a keeper
    number: 1
    heartsNeeded: 1
    path: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
