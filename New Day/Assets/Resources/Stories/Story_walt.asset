    pages:
    - I walked past your farm. Your fence posts are a disgrace. Leaning like drunks at a wedding.
    - ...I straightened three of them while you weren't looking. Don't thank me. It was offending my eyes, that's all.
    happy: 0
    ask:
      item: {fileID: 0}
      amount: 0
      minQuality: 0
