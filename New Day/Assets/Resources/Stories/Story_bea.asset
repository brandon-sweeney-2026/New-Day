      item: {fileID: 11400000, guid: 1d656e80098a50d4c862053aa84f9d54, type: 2}
      amount: 5
      friendship: 0
  - title: The soil lab
    number: 10
    heartsNeeded: 10
    path: 2
    conditions:
      days: 0
