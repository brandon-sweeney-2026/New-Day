  m_Name: Story_bea
  m_EditorClassIdentifier: Assembly-CSharp::NpcStoryArc
  npcId: bea
  title: Forty Questions
  summary: 'Bea studies botany and thinks farmers are heroes. Her thesis on your soil turns into proof of the pollution, and her supervisor''s grant comes from Sterling. Fork: publish the true results and lose the grant, or keep the grant and pass the data on quietly.'
  pathAName: Publish the results
  pathBName: Keep the grant
  parts:
  - title: The list
    number: 1
    heartsNeeded: 1
    path: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
