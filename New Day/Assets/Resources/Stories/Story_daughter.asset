  m_Name: Story_daughter
  m_EditorClassIdentifier: Assembly-CSharp::NpcStoryArc
  npcId: daughter
  title: The Seed Tin
  summary: 'A plant nerd who studies in the city. Soo-ah finds old local seeds in the store''s basement and wants to save them before Sterling''s patented seeds replace everything. Fork: start a free seed library in the store, or take an internship at Sterling AgriSeed to learn their secrets.'
  pathAName: The seed library
  pathBName: The internship
  parts:
  - title: You noticed, right?
    number: 1
    heartsNeeded: 1
    path: 0
    conditions:
      days: 0
      seasons: 0
