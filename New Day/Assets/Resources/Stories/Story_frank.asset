      optionB: 
      replyB: []
      flagsB: []
    setFlags: []
    reward:
      gold: 0
      item: {fileID: 0}
      amount: 0
      friendship: 0
  - title: Feet up
    number: 9
    heartsNeeded: 9
    path: 2
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
      requireFlags: []
      anyFlags: []
      forbidFlags: []
      counters: []
    pages:
    - I'm a man of leisure now. A house! With a bed! I've got nothing to fix.
    - Every morning I walk past the store. They've painted it grey. The sign says 'Sterling Home Essentials'. The tin of screws is gone.
    - Somebody's door wouldn't shut last night, on Maple Lane. They rang the store. It's shut at six now. Nobody came.
    happy: 0
    ask:
      item: {fileID: 0}
      amount: 0
      minQuality: 0
      questTitle: 
      questText: 
      reminder: []
      thanks: []
    choice:
      enabled: 0
