  m_Name: Story_frank
  m_EditorClassIdentifier: Assembly-CSharp::NpcStoryArc
  npcId: frank
  title: The Cot in the Office
  summary: 'Frank sold his house to keep the store open and sleeps on the cot in his back office. Sterling''s flat-pack doors undercut him. Part 4 needs 3 house upgrades. Fork: turn the store into a neighbourhood co-op, or sell it to Sterling for a fair price.'
  pathAName: The co-op
  pathBName: Sell to Sterling
  parts:
  - title: Measure twice
    number: 1
    heartsNeeded: 1
    path: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
