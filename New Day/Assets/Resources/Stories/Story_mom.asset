  m_EditorClassIdentifier: Assembly-CSharp::NpcStoryArc
  npcId: mom
  title: Have You Eaten?
  summary: 'Mi-sook feeds the whole street and never herself. Her ''Saturday friends in the city'' are really a cooking class she''s too shy to mention. Fork: enter a Sterling-sponsored cooking competition, or cook one big dinner for the whole street.'
  pathAName: The street dinner
  pathBName: The competition
  parts:
