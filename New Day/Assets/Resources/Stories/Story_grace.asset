  m_Name: Story_grace
  m_EditorClassIdentifier: Assembly-CSharp::NpcStoryArc
  npcId: grace
  title: What the River Remembers
  summary: 'Grace is writing the history of the valley and finds that the Sterling family''s first business poisoned the river long before the tower. Her university is funded by Sterling. Fork: publish and risk her job, or hide the files until the time is right.'
  pathAName: Publish the history
  pathBName: Keep the files safe
  parts:
  - title: Rent
    number: 1
    heartsNeeded: 1
    path: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
