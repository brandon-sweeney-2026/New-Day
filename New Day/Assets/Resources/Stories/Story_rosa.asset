      item: {fileID: 0}
      amount: 0
      friendship: 0
  - title: A secret between us
    number: 4
    heartsNeeded: 4
    path: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
      requireFlags: []
      anyFlags: []
      forbidFlags: []
      counters: []
    pages:
    - Promise me you won't tell Sam it's me. Please, dear.
    - If Sam knew, Sam would feel they owed me something. And then the bowl would stop coming back. I like it when the bowl comes back washed.
    - It's the only conversation we have, and it's a lovely one.
    happy: 0
    ask:
      item: {fileID: 0}
      amount: 0
      minQuality: 0
      questTitle: 
      questText: 
      reminder: []
      thanks: []
    choice:
      enabled: 0
      optionA: 
      replyA: []
