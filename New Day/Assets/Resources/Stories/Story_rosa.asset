  m_Name: Story_rosa
  m_EditorClassIdentifier: Assembly-CSharp::NpcStoryArc
  npcId: rosa
  title: The Soup on the Step
  summary: 'Rosa leaves soup on Sam''s step because Sam reminds her of her son Tomas, who works in the tower and never visits. The tower''s bakery counter hurts the Kims'' bread sales. Fork: start a plaza market, or sell her bread to the tower.'
  pathAName: The Saturday market
  pathBName: Bread for the tower
  parts:
  - title: A loaf for the farmer
    number: 1
    heartsNeeded: 1
    path: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
      requireFlags: []
      anyFlags: []
      forbidFlags: []
      counters: []
    pages:
    - There you are, dear! I baked an extra one this morning, and an extra one always has somebody's name on it.
    - Today it's yours. No, don't argue. Walt argues. You're not Walt.
    happy: 1
    ask:
      item: {fileID: 0}
      amount: 0
      minQuality: 0
