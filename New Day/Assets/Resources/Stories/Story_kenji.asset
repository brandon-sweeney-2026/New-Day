      item: {fileID: 0}
      amount: 0
      friendship: 0
  - title: One movement
    number: 3
    heartsNeeded: 3
    path: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
      requireFlags: []
      anyFlags: []
      forbidFlags: []
      counters: []
    pages:
    - Stand with me. Feet like this. Knees soft. Breathe in while the hands rise.
    - No, slower. Slower than that. Slower than you think a person can move.
    - Good. That is the whole secret. The rest is only practice. Here, have some tea. It is also slow.
    happy: 0
    ask:
      item: {fileID: 0}
      amount: 0
      minQuality: 0
      questTitle: 
      questText: 
      reminder: []
      thanks: []
