  m_Name: Story_kenji
  m_EditorClassIdentifier: Assembly-CSharp::NpcStoryArc
  npcId: kenji
  title: The Crow and the Board
  summary: 'Kenji is gentle and wise, and has been greeting the same crow every morning without reply. He is quietly planning to go home to Japan, and hasn''t told his daughter Yuki. Fork: encourage him to go, or to tell Yuki and decide together.'
  pathAName: Go home to Japan
  pathBName: Tell Yuki first
  parts:
  - title: Sit or stand
    number: 1
    heartsNeeded: 1
    path: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
      requireFlags: []
      anyFlags: []
      forbidFlags: []
      counters: []
    pages:
    - You came back. Sit, then. The bench is warm. Walt has been sitting on it all morning, losing.
    - He thinks three moves ahead. I think about lunch. You would be surprised how often lunch wins.
    happy: 0
    ask:
      item: {fileID: 0}
