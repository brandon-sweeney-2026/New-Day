  m_EditorClassIdentifier: Assembly-CSharp::NpcStoryArc
  npcId: nia
  title: Gregory's River
  summary: 'Nia wants to be a bug scientist, or a goalkeeper, or both. She is the first to notice the river is making the bugs sick. Fork: the science fair and the football cup final are on the same day. Neither is wrong; the other ending finds its way back.'
  pathAName: The science fair
  pathBName: The cup final
  parts:
  - title: How many legs?
    number: 1
    heartsNeeded: 1
    path: 0
    conditions:
      days: 0
      seasons: 0
      dayFrom: 0
      dayTo: 0
      minYear: 0
