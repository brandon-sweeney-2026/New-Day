      dayTo: 0
      minYear: 0
      minTotalDays: 0
      weather: 0
      requireFlags: []
      anyFlags: []
      forbidFlags: []
      counters: []
    pages:
    - Hi! You came back! Have you thought about left back? You've got the shoulders for it. Farm shoulders.
    - We train at four. Bring boots. Or don't, and just shout encouragement. Shouting is half of football.
