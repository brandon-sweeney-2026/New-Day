  m_Name: Story_lucia
  m_EditorClassIdentifier: Assembly-CSharp::NpcStoryArc
  npcId: lucia
  title: Shouting and Oranges
  summary: 'Lucia has energy for ten people. She wants to do good at city hall, but the system makes her stamp Sterling''s forms. Coaching is where she''s happiest. Fork: run for city council against Sterling''s candidate, or stay at her desk and very carefully lose the park-sale paperwork.'
  pathAName: Run for council
  pathBName: Lose the paperwork
  parts:
  - title: Left back
    number: 1
    heartsNeeded: 1
    path: 0
    conditions:
      days: 0
      seasons: 0
